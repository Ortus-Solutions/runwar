        "org.jboss.logging:jboss-logging": "maven:org.jboss.logging:jboss-logging:3.6.1.Final?transitive=false",
        "org.jboss.logging:jboss-logging-annotations": "maven:org.jboss.logging:jboss-logging-annotations:2.2.1.Final?transitive=false",
        "org.wildfly.common:wildfly-common": "maven:org.wildfly.common:wildfly-common:2.0.0?transitive=false",
        "org.wildfly.client:wildfly-client-config": "maven:org.wildfly.client:wildfly-client-config:1.0.1.Final?transitive=false",
        "io.smallrye.common:smallrye-common-annotation": "maven:io.smallrye.common:smallrye-common-annotation:2.6.0?transitive=false",
        "io.smallrye.common:smallrye-common-constraint": "maven:io.smallrye.common:smallrye-common-constraint:2.6.0?transitive=false",
        "io.smallrye.common:smallrye-common-cpu": "maven:io.smallrye.common:smallrye-common-cpu:2.6.0?transitive=false",
        "io.smallrye.common:smallrye-common-expression": "maven:io.smallrye.common:smallrye-common-expression:2.4.0?transitive=false",
        "io.smallrye.common:smallrye-common-function": "maven:io.smallrye.common:smallrye-common-function:2.6.0?transitive=false",
        "io.smallrye.common:smallrye-common-net": "maven:io.smallrye.common:smallrye-common-net:2.4.0?transitive=false",
        "io.smallrye.common:smallrye-common-os": "maven:io.smallrye.common:smallrye-common-os:2.4.0?transitive=false",
        "io.smallrye.common:smallrye-common-ref": "maven:io.smallrye.common:smallrye-common-ref:2.4.0?transitive=false",
        "jakarta.servlet:jakarta.servlet-api": "maven:jakarta.servlet:jakarta.servlet-api:6.0.0?transitive=false",
        "jakarta.servlet.jsp:jakarta.servlet.jsp-api": "maven:jakarta.servlet.jsp:jakarta.servlet.jsp-api:3.1.1?transitive=false",
        "jakarta.el:jakarta.el-api": "maven:jakarta.el:jakarta.el-api:4.0.0?transitive=false",
        "jakarta.annotation:jakarta.annotation-api": "maven:jakarta.annotation:jakarta.annotation-api:2.1.1?transitive=false",
        "jakarta.websocket:jakarta.websocket-api": "maven:jakarta.websocket:jakarta.websocket-api:2.1.0?transitive=false",
        "jakarta.websocket:jakarta.websocket-client-api": "maven:jakarta.websocket:jakarta.websocket-client-api:2.1.0?transitive=false",
        "org.apache.logging.log4j:log4j-api": "maven:org.apache.logging.log4j:log4j-api:2.25.3?transitive=false",
        "org.apache.logging.log4j:log4j-core": "maven:org.apache.logging.log4j:log4j-core:2.25.3?transitive=false",
        "org.apache.logging.log4j:log4j-layout-template-json": "maven:org.apache.logging.log4j:log4j-layout-template-json:2.25.3?transitive=false",
        "org.apache.logging.log4j:log4j-slf4j-impl": "maven:org.apache.logging.log4j:log4j-slf4j-impl:2.25.3?transitive=false",
        "org.apache.logging.log4j:log4j-slf4j2-impl": "maven:org.apache.logging.log4j:log4j-slf4j2-impl:2.25.3?transitive=false",
        "org.slf4j:slf4j-api": "maven:org.slf4j:slf4j-api:2.0.17?transitive=false",
        "net.minidev:json-smart-mini": "maven:net.minidev:json-smart-mini:1.3.2?transitive=false",
        "org.jooq:joox-java-6": "maven:org.jooq:joox-java-6:1.6.2?transitive=false",
        "org.tuckey:urlrewritefilter": "maven:org.tuckey:urlrewritefilter:5.1.3?transitive=false",
        "org.bouncycastle:bcpkix-jdk15on": "maven:org.bouncycastle:bcpkix-jdk15on:1.70?transitive=false",
        "org.bouncycastle:bcprov-jdk15on": "maven:org.bouncycastle:bcprov-jdk15on:1.70?transitive=false",
        "org.bouncycastle:bcutil-jdk15on": "maven:org.bouncycastle:bcutil-jdk15on:1.70?transitive=false",
        "com.jcabi:jcabi-log": "maven:com.jcabi:jcabi-log:0.24.1?transitive=false"
    },
    "scripts": {
        "preJavaCompile": [
            "delete 'dist/classes,dist/generated-resources,dist/release' --force --recurse",
            "fileWrite 'runwar.version=${@version}' dist/generated-resources/runwar/version.properties"
        ]
    },
    "java": {
        "source": "src/main/java",
        "classes": "dist/classes",
        "libsDir": "dist/release/${@version}",
        "resources": [
            "src/main/resources",
            "dist/generated-resources"
        ],
        "classPath": "dist/dependencies",
        "compileOptions": {
            "release": "11",
            "encoding": "UTF-8"
        },
        "jar": true,
        "fatJar": true,
        "manifest": {
            "Main-Class": "runwar.Start",
            "Automatic-Module-Name": "runwar",
            "Multi-Release": "true",
            "Can-Redefine-Classes": "true",
            "Can-Retransform-Classes": "true",
            "Bundle-Vendor": "cfmlprojects.org",
            "Bundle-License": "Apache-2.0"
        }
    }
}