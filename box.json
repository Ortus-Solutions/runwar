        "org.javassist:javassist": "maven:org.javassist:javassist:3.23.0-GA?transitive=false",
        "net.java.dev.jna:jna": "maven:net.java.dev.jna:jna:4.5.2?transitive=false",
        "net.java.dev.jna:jna-platform": "maven:net.java.dev.jna:jna-platform:4.5.2?transitive=false",
