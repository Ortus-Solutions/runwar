        "io.undertow:undertow-websockets-jsr": "maven:io.undertow:undertow-websockets-jsr:2.3.26.Final?transitive=false",
        "org.jboss.xnio:xnio-api": "maven:org.jboss.xnio:xnio-api:3.8.16.Final?transitive=false",
        "org.jboss.xnio:xnio-nio": "maven:org.jboss.xnio:xnio-nio:3.8.16.Final?transitive=false",
